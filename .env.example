# SteelTrace — environment variables
#
# Three distinct Postgres connections are required by this architecture
# (docs/physical-database-design.md §6, §12, §13). Never reuse one URL for
# another's purpose — each connects as a different Postgres role with
# deliberately different privileges.

# ---------------------------------------------------------------------------
# DATABASE_URL — Neon POOLED connection (pgbouncer), used by Prisma Client at
# runtime as the ordinary application role.
# This role operates under Row-Level Security (RLS) scoped to
# `app.current_company_id` / `app.current_user_id` (set per-request via
# `SET LOCAL` inside an interactive transaction, §13), and has no direct
# INSERT/UPDATE/DELETE grant on immutable/controlled tables — only EXECUTE on
# the controlled database functions defined in §12 (Task 3).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://<app_role>:<password>@<neon-pooled-host>/<database>?sslmode=require&pgbouncer=true&connect_timeout=15"

# ---------------------------------------------------------------------------
# DIRECT_URL — Neon DIRECT (unpooled) connection, used only by the Prisma CLI
# for `migrate`/`db push` operations, which require a direct connection
# (no pgbouncer) to run DDL and advisory locks correctly.
# ---------------------------------------------------------------------------
DIRECT_URL="postgresql://<app_role>:<password>@<neon-direct-host>/<database>?sslmode=require"

# ---------------------------------------------------------------------------
# IDENTITY_SERVICE_DATABASE_URL — connection as the narrow, dedicated
# `steeltrace_identity_service` Postgres role (§6). This role is the ONLY
# one holding INSERT on the global `users` table — it is used exclusively by
# the identity-service code path (registration and invitation acceptance,
# §6) and must never be used for ordinary, company-scoped application
# requests. Not referenced by prisma/schema.prisma's `datasource` block;
# consumed directly by the identity-service module at runtime.
# ---------------------------------------------------------------------------
IDENTITY_SERVICE_DATABASE_URL="postgresql://steeltrace_identity_service:<password>@<neon-pooled-host>/<database>?sslmode=require&pgbouncer=true&connect_timeout=15"

# ---------------------------------------------------------------------------
# JWT_SECRET — HMAC signing key for API session tokens (Task 5, §6/§6a).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# PORT — HTTP port the Fastify server listens on (default 3000 if unset).
# ---------------------------------------------------------------------------
JWT_SECRET="<random-base64-secret>"
PORT="3000"
