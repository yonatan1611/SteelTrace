  releasedByMembership CompanyMembership @relation("HoldReleaseReleasedBy", fields: [companyId, releasedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, materialUnitId])
  @@unique([companyId, id])
  @@map("material_hold_releases")
}

/// Hand-maintained in SQL migration (Task 3):
///   - CHECK exactly one of `(processing_operation_id, material_transfer_line_id,
///     physical_stock_count_line_id)` is NOT NULL (three-way, Edition 2).
///   - CHECK `(approved_by_membership_id IS NULL) = (approved_at IS NULL)`.
///   - `amount` is signed — see §10's one sign convention.
model ConservationAdjustment {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  processingOperationId    String?          @map("processing_operation_id") @db.Uuid
  materialTransferLineId   String?          @map("material_transfer_line_id") @db.Uuid
  physicalStockCountLineId String?          @map("physical_stock_count_line_id") @db.Uuid
  measurementBasis         MeasurementBasis @map("measurement_basis")
  amount                   Decimal          @db.Decimal(10, 3)
  adjustmentType           AdjustmentType   @map("adjustment_type")
  reason                   String
  recordedByMembershipId   String           @map("recorded_by_membership_id") @db.Uuid
  approvedByMembershipId   String?          @map("approved_by_membership_id") @db.Uuid
  approvedAt               DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  processingOperation    ProcessingOperation?    @relation(fields: [companyId, processingOperationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  materialTransferLine   MaterialTransferLine?   @relation(fields: [companyId, materialTransferLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  physicalStockCountLine PhysicalStockCountLine? @relation(fields: [companyId, physicalStockCountLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedByMembership   CompanyMembership       @relation("AdjustmentRecordedBy", fields: [companyId, recordedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedByMembership   CompanyMembership?      @relation("AdjustmentApprovedBy", fields: [companyId, approvedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, id])
  @@map("conservation_adjustments")
}

/// Hand-maintained in SQL migration (Task 3):
///   - CHECK exactly one of `processing_operation_id`/`processing_output_id` set.
///   - CHECK `structural_element_type_id IS NOT NULL OR structural_element_instance_id IS NOT NULL`.
model IntendedUsageDeclaration {
  id                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                   String       @map("company_id") @db.Uuid
  processingOperationId       String?      @map("processing_operation_id") @db.Uuid
  processingOutputId          String?      @map("processing_output_id") @db.Uuid
  structuralElementTypeId     String?      @map("structural_element_type_id") @db.Uuid
  structuralElementInstanceId String?      @map("structural_element_instance_id") @db.Uuid
  locationNodeId              String?      @map("location_node_id") @db.Uuid
  reinforcementPurposeId      String       @map("reinforcement_purpose_id") @db.Uuid
  bbsLineId                   String?      @map("bbs_line_id") @db.Uuid
  declaredByMembershipId      String       @map("declared_by_membership_id") @db.Uuid
  declaredAt                  DateTime     @default(now()) @map("declared_at") @db.Timestamptz(6)
  status                      RecordStatus @default(ACTIVE)
  supersedesId                String?      @map("supersedes_id") @db.Uuid

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  processingOperation       ProcessingOperation?       @relation(fields: [companyId, processingOperationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  processingOutput          ProcessingOutput?          @relation(fields: [companyId, processingOutputId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  structuralElementType     StructuralElementType?     @relation(fields: [companyId, structuralElementTypeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "iud_structural_element_type_fkey")
  structuralElementInstance StructuralElementInstance? @relation(fields: [companyId, structuralElementInstanceId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "iud_structural_element_instance_fkey")
  locationNode              LocationNode?              @relation(fields: [companyId, locationNodeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  reinforcementPurpose      ReinforcementPurpose       @relation(fields: [companyId, reinforcementPurposeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  bbsLine                   BbsLine?                   @relation("DeclarationBbsLine", fields: [companyId, bbsLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  declaredByMembership      CompanyMembership          @relation("DeclarationDeclaredBy", fields: [companyId, declaredByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  supersedes                IntendedUsageDeclaration?  @relation("IntendedUsageDeclarationSupersedes", fields: [companyId, supersedesId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  supersededByDeclarations IntendedUsageDeclaration[] @relation("IntendedUsageDeclarationSupersedes")
  materialReservations     MaterialReservation[]
  installations            Installation[]

  @@unique([companyId, id])
  @@map("intended_usage_declarations")
}

/// Hand-maintained in SQL migration (Task 3):
///   - CHECK (trigger) `(from, to)` must be a valid pair —
///     `PENDING_RECONCILIATION -> {PREPARED, OFFCUT, SCRAP}`, `OFFCUT -> SCRAP`.
///   - CHECK `(approved_by_membership_id IS NULL) = (approved_at IS NULL)`.
///   - Pure immutable event log except for the single-fill
///     `approved_by_*`/`approved_at` columns, filled at most once by the
///     `record_approval` function (§12).
model ReclassificationEvent {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String                 @map("company_id") @db.Uuid
  materialUnitId         String                 @map("material_unit_id") @db.Uuid
  fromClassification     MaterialClassification @map("from_classification")
  toClassification       MaterialClassification @map("to_classification")
  reason                 String
  recordedByMembershipId String                 @map("recorded_by_membership_id") @db.Uuid
  approvedByMembershipId String?                @map("approved_by_membership_id") @db.Uuid
  approvedAt             DateTime?              @map("approved_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  materialUnit         MaterialUnit       @relation(fields: [companyId, materialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  recordedByMembership CompanyMembership  @relation("ReclassificationRecordedBy", fields: [companyId, recordedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedByMembership CompanyMembership? @relation("ReclassificationApprovedBy", fields: [companyId, approvedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, id])
  @@map("reclassification_events")
}

// =============================================================================
// §9a — Bar Bending Schedules (BBS) (new, Edition 2)
// =============================================================================

/// New, Edition 2 (CLAUDE.md §2.16).
/// Hand-maintained in SQL migration (Task 3): CHECK `(approved_by_membership_id
/// IS NULL) = (approved_at IS NULL)`. Supersede-chain pattern (§15):
/// `status` toggles `ACTIVE -> SUPERSEDED`.
model BbsSchedule {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  projectId              String       @map("project_id") @db.Uuid
  referenceCode          String       @map("reference_code")
  drawingNumber          String?      @map("drawing_number")
  drawingRevision        String?      @map("drawing_revision")
  wastageAllowancePct    Decimal?     @map("wastage_allowance_pct") @db.Decimal(5, 2)
  status                 RecordStatus @default(ACTIVE)
  preparedByMembershipId String       @map("prepared_by_membership_id") @db.Uuid
  approvedByMembershipId String?      @map("approved_by_membership_id") @db.Uuid
  approvedAt             DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project              Project            @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  preparedByMembership CompanyMembership  @relation("BbsSchedulePreparedBy", fields: [companyId, preparedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedByMembership CompanyMembership? @relation("BbsScheduleApprovedBy", fields: [companyId, approvedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  bbsLines BbsLine[]

  @@unique([companyId, projectId, referenceCode])
  @@unique([companyId, id])
  @@map("bbs_schedules")
}

/// New, Edition 2 (CLAUDE.md §2.16).
/// Hand-maintained in SQL migration (Task 3):
///   - CHECK `structural_element_type_id IS NOT NULL OR structural_element_instance_id IS NOT NULL`.
///   - CHECK `cut_length_m > 0`, `bars_per_member > 0`, `member_count > 0`,
///     `total_bars_required = bars_per_member * member_count`.
model BbsLine {
  id                          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                   String           @map("company_id") @db.Uuid
  bbsScheduleId               String           @map("bbs_schedule_id") @db.Uuid
  structuralElementTypeId     String?          @map("structural_element_type_id") @db.Uuid
  structuralElementInstanceId String?          @map("structural_element_instance_id") @db.Uuid
  locationNodeId              String?          @map("location_node_id") @db.Uuid
  reinforcementPurposeId      String           @map("reinforcement_purpose_id") @db.Uuid
  barMark                     String           @map("bar_mark")
  diameterMm                  Decimal          @map("diameter_mm") @db.Decimal(6, 2)
  surfaceType                 RebarSurfaceType @default(DEFORMED) @map("surface_type")
  gradeNormalized             String           @map("grade_normalized")
  shapeCodeId                 String           @map("shape_code_id") @db.Uuid
  dimAMm                      Decimal?         @map("dim_a_mm") @db.Decimal(8, 2)
  dimBMm                      Decimal?         @map("dim_b_mm") @db.Decimal(8, 2)
  dimCMm                      Decimal?         @map("dim_c_mm") @db.Decimal(8, 2)
  dimDMm                      Decimal?         @map("dim_d_mm") @db.Decimal(8, 2)
  dimEMm                      Decimal?         @map("dim_e_mm") @db.Decimal(8, 2)
  dimRMm                      Decimal?         @map("dim_r_mm") @db.Decimal(8, 2)
  cutLengthM                  Decimal          @map("cut_length_m") @db.Decimal(10, 3)
  barsPerMember               Int              @map("bars_per_member")
  memberCount                 Int              @map("member_count")
  totalBarsRequired           Int              @map("total_bars_required")

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bbsSchedule               BbsSchedule                @relation(fields: [companyId, bbsScheduleId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  structuralElementType     StructuralElementType?     @relation(fields: [companyId, structuralElementTypeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  structuralElementInstance StructuralElementInstance? @relation(fields: [companyId, structuralElementInstanceId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  locationNode              LocationNode?              @relation(fields: [companyId, locationNodeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  reinforcementPurpose      ReinforcementPurpose       @relation(fields: [companyId, reinforcementPurposeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  shapeCode                 ShapeCode                  @relation(fields: [companyId, shapeCodeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  workOrders                WorkOrder[]                @relation("WorkOrderBbsLine")
  materialReservations      MaterialReservation[]      @relation("ReservationBbsLine")
  intendedUsageDeclarations IntendedUsageDeclaration[] @relation("DeclarationBbsLine")
  installations             Installation[]             @relation("InstallationBbsLine")

  @@unique([companyId, id])
  @@index([companyId, bbsScheduleId])
  @@index([companyId, shapeCodeId])
  @@map("bbs_lines")
}

// =============================================================================
// §9b — Physical Stock Count & Variance Reconciliation (new, Edition 2)
// =============================================================================

/// New, Edition 2 (CLAUDE.md §2.17).
/// Hand-maintained in SQL migration (Task 3): CHECK `(verified_by_membership_id
/// IS NULL) = (verified_at IS NULL)`.
model PhysicalStockCount {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  storageLocationId      String       @map("storage_location_id") @db.Uuid
  referenceCode          String       @map("reference_code")
  countDate              DateTime     @map("count_date") @db.Date
  status                 RecordStatus @default(ACTIVE)
  countedByMembershipId  String       @map("counted_by_membership_id") @db.Uuid
  verifiedByMembershipId String?      @map("verified_by_membership_id") @db.Uuid
  verifiedAt             DateTime?    @map("verified_at") @db.Timestamptz(6)
  notes                  String?
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  storageLocation      StorageLocation    @relation(fields: [companyId, storageLocationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  countedByMembership  CompanyMembership  @relation("StockCountCountedBy", fields: [companyId, countedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  verifiedByMembership CompanyMembership? @relation("StockCountVerifiedBy", fields: [companyId, verifiedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  physicalStockCountLines PhysicalStockCountLine[]

  @@unique([companyId, referenceCode])
  @@unique([companyId, id])
  @@map("physical_stock_counts")
}

/// New, Edition 2 (CLAUDE.md §2.17).
/// Hand-maintained in SQL migration (Task 3): CHECK `variance_length_m =
/// counted_length_m - system_length_m`. A variance is only a recorded
/// observation — it is not itself a write to inventory until a
/// corresponding, approved `ConservationAdjustment` exists (§9b).
model PhysicalStockCountLine {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String  @map("company_id") @db.Uuid
  physicalStockCountId String  @map("physical_stock_count_id") @db.Uuid
  materialUnitId       String  @map("material_unit_id") @db.Uuid
  systemPieces         Int     @map("system_pieces")
  systemLengthM        Decimal @map("system_length_m") @db.Decimal(10, 3)
  countedPieces        Int     @map("counted_pieces")
  countedLengthM       Decimal @map("counted_length_m") @db.Decimal(10, 3)
  varianceLengthM      Decimal @map("variance_length_m") @db.Decimal(10, 3)
  investigationNotes   String? @map("investigation_notes")

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  physicalStockCount PhysicalStockCount @relation(fields: [companyId, physicalStockCountId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  materialUnit       MaterialUnit       @relation(fields: [companyId, materialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  conservationAdjustments ConservationAdjustment[]

  @@unique([companyId, physicalStockCountId, materialUnitId])
  @@unique([companyId, id])
  @@map("physical_stock_count_lines")
}

// =============================================================================
// §11 — Receiving, Transfers, and Multiple Dispositions Per Receipt
// =============================================================================

/// Hand-maintained in SQL migration (Task 3):
///   - CHECK `from_location_id <> to_location_id`.
///   - Partial unique `(company_id, idempotency_key)` WHERE not null.
///   - Trigger gates `status -> 'RECEIVED'`: every line's placeholder must
///     have `remaining() = 0` (§9).
model MaterialTransfer {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String               @map("company_id") @db.Uuid
  projectId                String               @map("project_id") @db.Uuid
  fromLocationId           String               @map("from_location_id") @db.Uuid
  toLocationId             String               @map("to_location_id") @db.Uuid
  status                   TransferStatus       @default(DISPATCHED)
  dispatchedByMembershipId String               @map("dispatched_by_membership_id") @db.Uuid
  dispatchedAt             DateTime             @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  vehicleInfo              String?              @map("vehicle_info")
  idempotencyKey           String?              @map("idempotency_key")
  reconciliationStatus     ReconciliationStatus @default(UNRECONCILED) @map("reconciliation_status")

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project                Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  fromLocation           StorageLocation   @relation("TransferFromLocation", fields: [companyId, fromLocationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  toLocation             StorageLocation   @relation("TransferToLocation", fields: [companyId, toLocationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  dispatchedByMembership CompanyMembership @relation("TransferDispatchedBy", fields: [companyId, dispatchedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  materialTransferLines    MaterialTransferLine[]
  materialTransferReceipts MaterialTransferReceipt[]

  @@unique([companyId, id])
  @@index([companyId, projectId, status, dispatchedAt])
  @@map("material_transfers")
}

/// Simplified: no quantity columns (§2); always a freshly split placeholder.
model MaterialTransferLine {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String   @map("company_id") @db.Uuid
  materialTransferId      String   @map("material_transfer_id") @db.Uuid
  materialUnitId          String   @map("material_unit_id") @db.Uuid
  splitFromMaterialUnitId String   @map("split_from_material_unit_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company               Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  materialTransfer      MaterialTransfer @relation(fields: [companyId, materialTransferId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  materialUnit          MaterialUnit     @relation("MaterialTransferLinePlaceholder", fields: [companyId, materialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  splitFromMaterialUnit MaterialUnit     @relation("MaterialTransferLineSplitFrom", fields: [companyId, splitFromMaterialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  materialTransferReceiptLines MaterialTransferReceiptLine[]
  conservationAdjustments      ConservationAdjustment[]

  @@unique([companyId, materialUnitId])
  @@unique([companyId, id])
  @@index([companyId, splitFromMaterialUnitId])
  @@map("material_transfer_lines")
}

/// One transfer, many receipt events over time.
model MaterialTransferReceipt {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  materialTransferId     String   @map("material_transfer_id") @db.Uuid
  receivedByMembershipId String   @map("received_by_membership_id") @db.Uuid
  receivedAt             DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  notes                  String?

  company              Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  materialTransfer     MaterialTransfer  @relation(fields: [companyId, materialTransferId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  receivedByMembership CompanyMembership @relation("ReceiptReceivedBy", fields: [companyId, receivedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  materialTransferReceiptLines MaterialTransferReceiptLine[]

  @@unique([companyId, id])
  @@map("material_transfer_receipts")
}

/// Simplified (no quantity columns, §2), plus `disposition` (resolves issue #2).
/// One receipt event may contain several rows against the same
/// `materialTransferLineId`, each with its own disposition and freshly
/// materialized unit.
/// Hand-maintained in SQL migration (Task 3):
///   - Trigger at insert: new unit's `status` = `AVAILABLE` if
///     `disposition='ACCEPTED'`, else `ON_HOLD`; `current_storage_location_id`
///     = the transfer's `to_location_id`; spec inherited unchanged.
///   - Trigger, cumulative check: `Σ(resulting units' total_length_m) +
///     Σ(conservation_adjustments.amount > 0) <= placeholder.total_length_m`.
model MaterialTransferReceiptLine {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                 String             @map("company_id") @db.Uuid
  materialTransferReceiptId String             @map("material_transfer_receipt_id") @db.Uuid
  materialTransferLineId    String             @map("material_transfer_line_id") @db.Uuid
  resultingMaterialUnitId   String             @map("resulting_material_unit_id") @db.Uuid
  disposition               ReceiptDisposition @default(ACCEPTED)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  materialTransferReceipt MaterialTransferReceipt @relation(fields: [companyId, materialTransferReceiptId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "mtrl_receipt_fkey")
  materialTransferLine    MaterialTransferLine    @relation(fields: [companyId, materialTransferLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "mtrl_transfer_line_fkey")
  resultingMaterialUnit   MaterialUnit            @relation("MaterialTransferReceiptLineResult", fields: [companyId, resultingMaterialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, resultingMaterialUnitId])
  @@unique([companyId, id])
  @@index([companyId, materialTransferLineId])
  @@map("material_transfer_receipt_lines")
}

// =============================================================================
// Installation — canonical definition (docs/physical-database-design.md §11a)
//
// §11a closes the documentation gap found during Task 2: `installations`/
// `installation_lines` now have an explicit, column-by-column definition.
// This supersedes Task 2's inferred shape, which had (incorrectly) put
// `structuralElementInstanceId`/`reinforcementPurposeId` on `InstallationLine`
// — the canonical shape puts them on `Installation` itself: ONE installation
// event targets ONE element + ONE purpose, fed by potentially MANY
// `InstallationLine` rows (one per source `MaterialUnit`) — matching
// data-model.md §15 Example D (one `Installation` for Column C-12 / main
// reinforcement, three `InstallationLine` rows, one per source unit).
// =============================================================================

/// Supersede-chain pattern (§15), with its own maker-checker site QC
/// sign-off (`verifiedByMembershipId`/`verifiedAt`) — the same combination
/// `BbsSchedule` already uses.
/// Hand-maintained in SQL migration (Task 3): CHECK `(verified_by_membership_id
/// IS NULL) = (verified_at IS NULL)`.
model Installation {
  id                          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                   String       @map("company_id") @db.Uuid
  projectId                   String       @map("project_id") @db.Uuid
  structuralElementInstanceId String       @map("structural_element_instance_id") @db.Uuid
  reinforcementPurposeId      String       @map("reinforcement_purpose_id") @db.Uuid
  intendedUsageDeclarationId  String?      @map("intended_usage_declaration_id") @db.Uuid
  bbsLineId                   String?      @map("bbs_line_id") @db.Uuid
  installedByMembershipId     String       @map("installed_by_membership_id") @db.Uuid
  installedAt                 DateTime     @default(now()) @map("installed_at") @db.Timestamptz(6)
  verifiedByMembershipId      String?      @map("verified_by_membership_id") @db.Uuid
  verifiedAt                  DateTime?    @map("verified_at") @db.Timestamptz(6)
  status                      RecordStatus @default(ACTIVE)
  supersedesId                String?      @map("supersedes_id") @db.Uuid
  notes                       String?

  company                   Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project                   Project                   @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  structuralElementInstance StructuralElementInstance @relation(fields: [companyId, structuralElementInstanceId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  reinforcementPurpose      ReinforcementPurpose      @relation(fields: [companyId, reinforcementPurposeId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  intendedUsageDeclaration  IntendedUsageDeclaration? @relation(fields: [companyId, intendedUsageDeclarationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  bbsLine                   BbsLine?                  @relation("InstallationBbsLine", fields: [companyId, bbsLineId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  installedByMembership     CompanyMembership         @relation("InstallationInstalledBy", fields: [companyId, installedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  verifiedByMembership      CompanyMembership?        @relation("InstallationVerifiedBy", fields: [companyId, verifiedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  supersedes                Installation?             @relation("InstallationSupersedes", fields: [companyId, supersedesId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  supersededByInstallations Installation[]     @relation("InstallationSupersedes")
  installationLines         InstallationLine[]

  @@unique([companyId, id])
  @@index([companyId, projectId, installedAt])
  @@index([companyId, structuralElementInstanceId])
  @@map("installations")
}

/// Pure immutable event log (§15/§16) — NO quantity/length/weight columns:
/// installation always consumes the entire `MaterialUnit` row it references
/// (`install_material` has no partial-amount parameter at all, §12).
/// Deliberately NOT unique on `materialUnitId` alone (only on
/// `(companyId, installationId, materialUnitId)`) — a superseded
/// `Installation`'s lines legitimately keep referencing a unit that a new,
/// superseding `Installation`'s lines also reference (§11a).
model InstallationLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  installationId String   @map("installation_id") @db.Uuid
  materialUnitId String   @map("material_unit_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  installation Installation @relation(fields: [companyId, installationId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  materialUnit MaterialUnit @relation(fields: [companyId, materialUnitId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, installationId, materialUnitId])
  @@unique([companyId, id])
  @@index([companyId, materialUnitId])
  @@index([companyId, installationId])
  @@map("installation_lines")
}

// =============================================================================
// §15 — Auditability: Document Attachments & Audit Log
// =============================================================================

/// New, Edition 2 (CLAUDE.md §2.19). `targetTable`/`targetRecordId` are a
/// deliberately generic polymorphic reference (MTC certificates, weighbridge
/// tickets, delivery notes, signed count sheets can each attach to several
/// different kinds of record) — NOT a Prisma/DB foreign key.
/// Hand-maintained in SQL migration (Task 3):
///   - CHECK `file_size_bytes > 0`.
///   - Trigger validates `target_table` against a fixed allow-list and that
///     the referenced row's own `company_id` matches this attachment's
///     `company_id` — since a polymorphic string reference can't be a real
///     composite FK, this trigger is what preserves the "no cross-tenant
///     relationship" guarantee (§13) for this one necessarily-generic table.
model Attachment {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  targetTable            String   @map("target_table")
  targetRecordId         String   @map("target_record_id") @db.Uuid
  fileName               String   @map("file_name")
  mimeType               String   @map("mime_type")
  fileSizeBytes          BigInt   @map("file_size_bytes")
  storageKey             String   @map("storage_key")
  uploadedByMembershipId String   @map("uploaded_by_membership_id") @db.Uuid
  uploadedAt             DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  company              Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedByMembership CompanyMembership @relation("AttachmentUploadedBy", fields: [companyId, uploadedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, id])
  @@index([companyId, targetTable, targetRecordId])
  @@map("attachments")
}

model AuditLog {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  tableName             String   @map("table_name")
  recordId              String   @map("record_id") @db.Uuid
  fieldName             String   @map("field_name")
  oldValue              String?  @map("old_value")
  newValue              String?  @map("new_value")
  changedByMembershipId String   @map("changed_by_membership_id") @db.Uuid
  changedAt             DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByMembership CompanyMembership @relation("AuditLogChangedBy", fields: [companyId, changedByMembershipId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([companyId, id])
  @@index([companyId, tableName, recordId])
  @@map("audit_log")
}
